rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTransaction(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.type in ['INCOME', 'EXPENSE'] &&
             (data.amount is float || data.amount is int) &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 40 &&
             data.description is string &&
             data.description.size() <= 200 &&
             data.transactionDateMillis is int &&
             data.transactionDateMillis > 0;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId) && isValidId(transactionId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'type',
                         'amount',
                         'category',
                         'description',
                         'transactionDateMillis',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'type',
                         'amount',
                         'category',
                         'description',
                         'transactionDateMillis',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidTransaction(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       isValidTransaction(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'type',
                         'amount',
                         'category',
                         'description',
                         'transactionDateMillis',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(transactionId);
    }
  }
}
